{
  "$schema": "https://opencode.ai/config-schema.json",
  "name": "tengence-geo",
  "model": {
    "provider": "deepseek",
    "model": "deepseek-chat",
    "options": {
      "apiKey": "${DEEPSEEK_API_KEY}",
      "baseURL": "https://api.deepseek.com"
    }
  },
  "agent": {
    "mode": "plan",
    "prompt": "You are a GEO content engine operations assistant. Follow the system prompt in apps/agent/presets/agent.md."
  },
  "tools": {
    "mcp": {
      "tengence-geo": {
        "command": "npx",
        "args": ["-y", "@tengence/geo-mcp"],
        "env": {
          "SITES_ROOT": "${SITES_ROOT}",
          "DB_DRIVER": "${DB_DRIVER:-sqlite}",
          "DB_PATH": "${DB_PATH:-}"
        }
      }
    }
  }
}
