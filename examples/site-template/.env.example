# ============================================================
# Site sensitive-config template — copy to .env and fill in (.env is gitignored)
# ============================================================

# Tenant ID: SQLite single-file multi-tenancy isolates by app_id; MySQL mode filters by app_id too
APP_ID=1

# ---- Storage: DB_DRIVER=sqlite (default, zero-config) | mysql (production, needs the MySQL vars below) ----
DB_DRIVER=sqlite
# DB_PATH optional; defaults to ~/.tengence/geo.sqlite
# DB_PATH=/absolute/path/to/geo.sqlite

# ---- MySQL production mode (required when DB_DRIVER=mysql) ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=geo
DB_PASSWORD=change-me
DB_DATABASE=tengence_geo

# ---- WordPress REST API (required by the publish chain) ----
WP_URL=
WP_API_URL=
WP_USERNAME=
WP_PASSWORD=

# ---- Inclusion submission (optional; missing values soft-fail without blocking publishing) ----
INDEXNOW_KEY=
BAIDU_TOKEN=
# GSC needs a proxy on CN networks
# HTTPS_PROXY=

# ---- Stock-library API keys (for the image pipeline, optional) ----
PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=
UNSPLASH_APP_ID=
UNSPLASH_SECRET_KEY=
PIXABAY_API_KEY=

# ---- GSC service account (for search inclusion, optional) ----
# GOOGLE_SA_JSON=/abs/path/to/gsc-service-account.json
