# Dependencies
node_modules/

# Sensitive config (site credentials)
.env
**/.env
!**/.env.example

# Local data & databases
*.sqlite
*.sqlite-wal
*.sqlite-shm
data/
.tengence/

# Build output
dist/
build/
coverage/

# Platform credentials (never commit: Client ID / Client Secret / tokens)
*.credentials.md
*.credentials.local.md
credentials.local.*

# Connector submission packages (regenerate from connector/ at any time)
*.zip

# Logs
*.log
npm-debug.log*

# Editor / OS
.DS_Store
.idea/
.vscode/

# Local agent workspace data (memory / session state, never committed)
.workbuddy/

# Local-only runtime (MCP server start scripts / env / logs, never committed)
.local/

# Local test-run artifacts (auto-initialized by diagnose tests)
examples/127_0_0_1/
*.tgz
